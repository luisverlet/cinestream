# ==============================================================================
# VERLET-CINE - VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# Copia este archivo a `.env` y ajusta las credenciales de tus servicios.
# NUNCA subas el archivo `.env` real con tokens a Git.
# ==============================================================================

# Entorno general
ENVIRONMENT=production
SECRET_KEY=cambiar_por_un_hash_aleatorio_seguro_para_firmar_tokens

# ------------------------------------------------------------------------------
# PUERTOS Y RED LOCAL
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8088

# ------------------------------------------------------------------------------
# JELLYFIN
# ------------------------------------------------------------------------------
# En docker compose, el servicio se llama "jellyfin" y corre en el puerto 8096.
# Si está en el mismo host por Docker, usa: http://jellyfin:8096
JELLYFIN_URL=http://jellyfin:8096/jellyfin
# API Key generada en Jellyfin Dashboard -> Claves de API (API Keys)
JELLYFIN_API_KEY=tu_jellyfin_api_key_aqui
# Nombre de la aplicación cliente reportada a Jellyfin
JELLYFIN_CLIENT_NAME=verlet-cine

# ------------------------------------------------------------------------------
# PROWLARR (Indexador de Torrents)
# ------------------------------------------------------------------------------
# URL interna en Docker o local
PROWLARR_URL=http://prowlarr:9696
# API Key obtenida en Prowlarr -> Settings -> General -> Security -> API Key
PROWLARR_API_KEY=tu_prowlarr_api_key_aqui

# ------------------------------------------------------------------------------
# QBITTORRENT (Descargas Secuenciales)
# ------------------------------------------------------------------------------
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USER=admin
# Nota: En versiones recientes de qBittorrent, la contraseña inicial se genera en los logs del contenedor:
# docker logs verlet-qbittorrent
QBITTORRENT_PASS=adminadmin

# ------------------------------------------------------------------------------
# BAZARR (Gestor de Subtítulos)
# ------------------------------------------------------------------------------
BAZARR_URL=http://bazarr:6767
# API Key obtenida en Bazarr -> Settings -> General -> Security -> API Key
BAZARR_API_KEY=tu_bazarr_api_key_aqui

# ------------------------------------------------------------------------------
# RUTAS DE MEDIOS EN EL HOST
# ------------------------------------------------------------------------------
# Ajusta estas rutas a las carpetas reales de tu servidor o deja las relativas
HOST_MEDIA_MOVIES=./media/movies
HOST_MEDIA_TV=./media/tv
HOST_MEDIA_DOWNLOADS=./media/downloads

# ------------------------------------------------------------------------------
# OPENSUBTITLES (Descarga Automática de Subtítulos en Español)
# ------------------------------------------------------------------------------
# Credenciales opcionales de cuenta en OpenSubtitles.com
OPENSUBTITLES_USER=tu_usuario_opensubtitles
OPENSUBTITLES_PASS=tu_password_opensubtitles
OPENSUBTITLES_API_KEY=tu_api_key_opensubtitles

# ------------------------------------------------------------------------------
# CLOUDFLARE TUNNEL (ACCESO GLOBAL SEGURO)
# ------------------------------------------------------------------------------
# Token del túnel creado en Zero Trust Dashboard -> Networks -> Tunnels
# (Placeholder de ejemplo: copia tu token real solo en tu archivo local .env)
CLOUDFLARE_TUNNEL_TOKEN=tu_cloudflare_tunnel_token_aqui
